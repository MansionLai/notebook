{
  "mcpServers": {
    "ceph": {
      "command": "uv",
      "args": [
        "run",
        "--with-editable",
        "/Users/mansionlai/Documents/copilot/notebook/storage/ceph-mcp-server/src",
        "python",
        "-m",
        "ceph_mcp.server"
      ],
      "env": {
        "CEPH_MANAGER_URL": "https://10.10.10.21:8443",
        "CEPH_USERNAME": "admin",
        "CEPH_PASSWORD": "${VAULT_CEPH_PASSWORD}",
        "CEPH_SSL_VERIFY": "false",
        "LOG_LEVEL": "INFO",
        "MAX_REQUESTS_PER_MINUTE": "60"
      }
    }
  }
}
