# Ceph 3-node cluster inventory
# MON nodes also serve as admin nodes (can execute ceph commands)

[ceph_mon]
ceph-node-01 ansible_host=20.89.53.16 ceph_public_ip=10.10.10.21
ceph-node-02 ansible_host=20.48.105.50 ceph_public_ip=10.10.10.22
ceph-node-03 ansible_host=20.48.36.4 ceph_public_ip=10.10.10.23

[ceph_osd]
ceph-node-01 ansible_host=20.89.53.16 ceph_public_ip=10.10.10.21 ceph_cluster_ip=172.10.10.21 rack=rack1
ceph-node-02 ansible_host=20.48.105.50 ceph_public_ip=10.10.10.22 ceph_cluster_ip=172.10.10.22 rack=rack2
ceph-node-03 ansible_host=20.48.36.4 ceph_public_ip=10.10.10.23 ceph_cluster_ip=172.10.10.23 rack=rack3

[ceph_osd:vars]
datacenter=dc1
room=room1

# Convenience group: all nodes for common setup
[ceph_nodes:children]
ceph_mon
ceph_osd
