[SERVICE]
    Flush        1
    Daemon       Off
    Log_Level    info

[INPUT]
    Name              tail
    Path              /var/log/syslog,/var/log/kern.log,/var/log/ceph/*.log
    Tag               ceph.lab
    DB                /var/log/fluent-bit-ceph.db
    Read_from_Head    true

[FILTER]
    Name    record_modifier
    Match   ceph.lab
    Record  host ${HOSTNAME}

[OUTPUT]
    Name            opensearch
    Match           ceph.lab
    Host            {{ fluent_bit_opensearch_host }}
    Port            {{ fluent_bit_opensearch_port }}
    HTTP_User       {{ fluent_bit_opensearch_username }}
    HTTP_Passwd     {{ fluent_bit_opensearch_password }}
    tls             On
    tls.verify      Off
    Suppress_Type_Name On
    Index           {{ fluent_bit_opensearch_index }}
